{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared/city/schema/region.schema.json",
  "title": "City region record, schema 1 (PIPE-01 freeze, 2026-11-08)",
  "description": "One tracked record per location (exterior district or interior venue). IDs, citations, hashes and reviewed placements only; no ROM-derived bulk data. Field meaning: docs/FULL_CITY_PLAN.md section 3.2 and shared/city/schema/README.md. Unknown keys are rejected everywhere.",
  "$defs": {
    "hex": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "aabb": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "$ref": "#/$defs/vec3" }, "max": { "$ref": "#/$defs/vec3" } }
    },
    "matrix4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
    },
    "locId": { "type": "string", "pattern": "^loc\\.[a-z][a-z0-9_]*$" },
    "roomId": { "type": "string", "pattern": "^loc\\.[a-z][a-z0-9_]*\\.room_[0-9]{2}$" },
    "portalId": { "type": "string", "pattern": "^portal\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)?$" },
    "profileId": { "type": "string", "pattern": "^prof\\.d[1-3]\\.[a-z]+\\.[a-z0-9]+$" },
    "cameraId": { "type": "string", "pattern": "^cam\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "routeId": { "type": "string", "pattern": "^(route\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*|R[0-9]{1,2})$" },
    "anchorId": { "type": "string", "pattern": "^anchor\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$" },
    "waterId": { "type": "string", "pattern": "^water\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "readiness": { "type": "string", "enum": ["not_run", "pass", "fail", "blocked", "not_applicable", "partial"] },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "materialBindings": {
      "type": "object", "additionalProperties": false, "required": ["sourceMaterials", "exportedImages", "repaintFiles", "repaintedSlots"],
      "properties": {
        "sourceMaterials": { "type": "integer", "minimum": 0 }, "exportedImages": { "type": "integer", "minimum": 0 },
        "repaintFiles": { "type": "integer", "minimum": 0 }, "repaintedSlots": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "regionId", "displayLabel", "source", "selection", "localSourceInputs", "sourceFrame",
    "conversionToUnity", "authoredRegistrationMatrix", "provisionalPhysicalScale", "bounds", "anchors", "rooms",
    "components", "collisionOwnership", "portalIds", "materialBindings", "cameraIds", "routeIds", "omissions",
    "excluded", "unsupported", "evidence", "readiness"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "regionId": { "$ref": "#/$defs/locId" },
    "aliases": { "$ref": "#/$defs/stringList" },
    "displayLabel": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sceneSymbol", "sceneEnum", "sceneTableIndex", "entranceTableSceneIndex", "baseline", "decompRevision", "extractorSha256", "fast64Revision"],
      "properties": {
        "sceneSymbol": { "type": "string", "pattern": "^Z2_[A-Z0-9_]+$" },
        "sceneEnum": { "type": "string", "pattern": "^SCENE_[A-Z0-9_]+$" },
        "sceneTableIndex": { "$ref": "#/$defs/hex" },
        "entranceTableSceneIndex": { "$ref": "#/$defs/hex" },
        "baseline": { "type": "string" },
        "decompRevision": { "type": "string", "pattern": "^zeldaret/mm [0-9a-f]{40}$" },
        "extractorSha256": { "$ref": "#/$defs/sha256" },
        "fast64Revision": { "type": ["string", "null"] }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "sceneLayer", "halfDayBit", "stateAssumptions"],
      "properties": {
        "profile": { "$ref": "#/$defs/profileId" },
        "sceneLayer": { "type": "integer", "minimum": 0, "maximum": 15 },
        "halfDayBit": { "$ref": "#/$defs/hex" },
        "stateAssumptions": { "$ref": "#/$defs/stringList" }
      }
    },
    "localSourceInputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": { "path": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } }
      }
    },
    "localExports": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256", "producedBy"],
        "properties": {
          "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" }, "writtenLocal": { "type": "string" },
          "producedBy": { "type": "string", "enum": ["committed-scripts", "inferred-committed-scripts", "unrecorded"] }
        }
      }
    },
    "sourceFrame": {
      "type": "object", "additionalProperties": false, "required": ["units", "up", "sharedFrame"],
      "properties": {
        "units": { "const": "N64 world units" },
        "up": { "const": "+Y" },
        "sharedFrame": {
          "type": "object", "additionalProperties": false, "required": ["with", "status", "evidence"],
          "properties": {
            "with": { "type": "array", "items": { "$ref": "#/$defs/locId" } },
            "status": { "type": "string", "enum": ["inferred", "verified", "unknown", "not_shared"] },
            "evidence": { "type": "string" }
          }
        }
      }
    },
    "conversionToUnity": {
      "type": "object", "additionalProperties": false, "required": ["matrix", "rule"],
      "properties": {
        "matrix": { "const": [[0.01, 0, 0, 0], [0, 0.01, 0, 0], [0, 0, -0.01, 0], [0, 0, 0, 1]] },
        "rule": { "const": "Unity (x, y, z) = N64 (x, y, -z) / 100" }
      }
    },
    "authoredRegistrationMatrix": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/matrix4" }] },
    "provisionalPhysicalScale": { "type": "boolean" },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["sourceCollisionHeader", "sourceCollisionVertices"],
      "properties": {
        "sourceCollisionHeader": { "$ref": "#/$defs/aabb" },
        "sourceCollisionVertices": { "$ref": "#/$defs/aabb" },
        "unityCollisionVertices": { "$ref": "#/$defs/aabb" },
        "unityImportRecorded": { "$ref": "#/$defs/aabb" }
      }
    },
    "water": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "sourceWaterBox", "behavior"],
        "properties": {
          "id": { "$ref": "#/$defs/waterId" },
          "sourceWaterBox": {
            "type": "object", "additionalProperties": false,
            "required": ["xMin", "xMax", "zMin", "zMax", "surfaceY", "properties"],
            "properties": {
              "xMin": { "type": "number" }, "xMax": { "type": "number" }, "zMin": { "type": "number" }, "zMax": { "type": "number" },
              "surfaceY": { "type": "number" }, "properties": { "$ref": "#/$defs/hex" },
              "bgCamIndex": { "type": "integer" }, "lightIndex": { "type": "integer" }, "room": { "type": "integer" }, "disabled": { "type": "boolean" }
            }
          },
          "unity": {
            "type": "object", "additionalProperties": false, "required": ["x", "z", "surfaceY"],
            "properties": {
              "x": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "z": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "surfaceY": { "type": "number" }
            }
          },
          "poolFloorY": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "bankFloorY": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "surfaceMesh": { "type": "string" },
          "behavior": { "type": "string" }
        }
      }
    },
    "anchors": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "source", "unity", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/anchorId" },
          "source": { "$ref": "#/$defs/vec3" },
          "unity": { "$ref": "#/$defs/vec3" },
          "status": { "type": "string", "enum": ["proposed", "probed", "surveyed"] },
          "note": { "type": "string" }
        }
      }
    },
    "rooms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "sourceRoom", "header", "roomShape", "displayLists"],
        "properties": {
          "id": { "$ref": "#/$defs/roomId" },
          "sourceRoom": { "type": "string", "pattern": "^Z2_[A-Z0-9_]+_room_[0-9]{2}$" },
          "header": { "type": "integer", "minimum": 0, "maximum": 15 },
          "roomShape": { "type": "string" },
          "displayLists": { "type": "integer", "minimum": 0 },
          "lodBranchesNotImported": { "type": "integer", "minimum": 0 },
          "role": { "type": "string" },
          "collisionLightIndex": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["sourceKey", "actorId", "params", "class", "status"],
        "properties": {
          "sourceKey": { "type": "string", "pattern": "^Z2_[A-Z0-9_]+/h[0-9]+/(room_[0-9]{2}/a[0-9]+(/[a-z0-9-]+)?|ta[0-9]+(-ta[0-9]+)?|transition/ta[0-9]+)$" },
          "actorId": { "$ref": "#/$defs/hex" },
          "params": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{4}((,|-)0x[0-9A-Fa-f]{4})*$" },
          "class": { "type": "string", "enum": ["static-mesh", "posed-skeletal", "npc-scheduled", "billboard-effect", "controller-invisible", "door-transition"] },
          "variant": { "type": "string", "enum": ["camera-relative", "state-pickup", "spawned", "posed-skeletal"] },
          "dls": { "$ref": "#/$defs/stringList" },
          "status": { "type": "string", "enum": ["selected", "imported", "optional"] },
          "note": { "type": "string" }
        }
      }
    },
    "collisionOwnership": {
      "type": "object", "additionalProperties": false, "required": ["room", "actorDynapoly", "actorCylinders"],
      "properties": {
        "room": { "type": "string" },
        "waterBoxes": { "type": "integer", "minimum": 0 },
        "actorDynapoly": { "$ref": "#/$defs/stringList" },
        "actorCylinders": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/stringList" }] },
        "note": { "type": "string" }
      }
    },
    "portalIds": { "type": "array", "items": { "$ref": "#/$defs/portalId" } },
    "materialBindings": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/materialBindings" }] },
    "cameraIds": { "type": "array", "items": { "$ref": "#/$defs/cameraId" } },
    "routeIds": { "type": "array", "items": { "$ref": "#/$defs/routeId" } },
    "omissions": { "$ref": "#/$defs/stringList" },
    "excluded": {
      "type": "object", "additionalProperties": false, "required": ["halfDayMask", "stateOrSchedule", "noGeometry"],
      "properties": {
        "halfDayMask": { "$ref": "#/$defs/stringList" },
        "stateOrSchedule": { "$ref": "#/$defs/stringList" },
        "noGeometry": { "$ref": "#/$defs/stringList" }
      }
    },
    "unsupported": { "$ref": "#/$defs/stringList" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceInspection", "objectExtraction", "import", "controllerTraversal", "editorRender", "packagedRender", "visualApproval"],
      "properties": {
        "sourceInspection": { "$ref": "#/$defs/readiness" },
        "objectExtraction": { "$ref": "#/$defs/readiness" },
        "import": { "$ref": "#/$defs/readiness" },
        "controllerTraversal": { "$ref": "#/$defs/readiness" },
        "editorRender": { "$ref": "#/$defs/readiness" },
        "packagedRender": { "$ref": "#/$defs/readiness" },
        "visualApproval": { "$ref": "#/$defs/readiness" }
      }
    },
    "readinessNotes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
