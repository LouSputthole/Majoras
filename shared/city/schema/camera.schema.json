{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared/city/schema/camera.schema.json",
  "title": "Capture camera record, schema 1 (PIPE-01 freeze, 2026-11-08)",
  "description": "One record per camera in shared/city/cameras/<region-id>.json (not yet generated; REF-03 capture work fills it). Field meaning: docs/FULL_CITY_PLAN.md section 3.4 and docs/city/SOURCE_REGISTER.md section 5. Unknown keys are rejected.",
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "result": { "type": "string", "enum": ["not_run", "pass", "fail", "blocked", "not_applicable"] }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cameraId", "regionId", "intent", "profiles", "abMode", "transform", "uncertainty", "captures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cameraId": { "type": "string", "pattern": "^cam\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "regionId": { "type": "string", "pattern": "^loc\\.[a-z][a-z0-9_]*$" },
    "intent": { "type": "string", "minLength": 1 },
    "profiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^prof\\.d[1-3]\\.[a-z]+\\.[a-z0-9]+$" } },
    "abMode": { "type": "string", "enum": ["A1", "A2", "B", "A1/B", "A2/B"] },
    "overlay": { "type": "boolean" },
    "transform": {
      "type": "object", "additionalProperties": false, "required": ["frame", "status"],
      "properties": {
        "frame": { "type": "string", "enum": ["n64", "unity"] },
        "status": { "type": "string", "enum": ["proposed", "measured"] },
        "position": { "$ref": "#/$defs/vec3" }, "lookAt": { "$ref": "#/$defs/vec3" }, "eulerDegrees": { "$ref": "#/$defs/vec3" },
        "fovDegrees": { "type": "number", "minimum": 1, "maximum": 179 }, "aspect": { "type": "number", "minimum": 0.1 },
        "nearClip": { "type": "number", "minimum": 0 }, "farClip": { "type": "number", "minimum": 0 }
      }
    },
    "renderer": { "type": "string" },
    "lightPreset": { "type": "string" },
    "uncertainty": { "type": "string", "enum": ["U-TBD", "low", "medium", "high"] },
    "captures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["profile", "kind", "path", "sha256", "result"],
        "properties": {
          "profile": { "type": "string", "pattern": "^prof\\.d[1-3]\\.[a-z]+\\.[a-z0-9]+$" },
          "kind": { "type": "string", "enum": ["source", "unity-editor", "unity-packaged", "overlay", "flat", "wireframe"] },
          "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceRevision": { "type": "string" }, "dirtyFingerprint": { "type": "string" }, "toolVersions": { "type": "string" },
          "timestamp": { "type": "string" }, "machine": { "type": "string" }, "result": { "$ref": "#/$defs/result" }, "note": { "type": "string" }
        }
      }
    }
  }
}
