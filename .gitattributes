* text=auto
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.cs text eol=lf
*.yml text eol=lf
# Unity serializes empty YAML values with a trailing space; preserve its output.
Unity/**/*.meta text eol=lf whitespace=-blank-at-eol
Unity/ProjectSettings/*.asset text eol=lf whitespace=-blank-at-eol
Unity/ProjectSettings/ProjectVersion.txt text eol=lf
*.png binary
*.glb binary
*.blend binary
*.fbx binary
